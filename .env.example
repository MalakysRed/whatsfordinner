# Anthropic. Server-side only — never expose to the browser (PRD A8).
ANTHROPIC_API_KEY=

# Supabase. URL and anon key are safe in the client bundle; RLS is what protects
# the data. The service role key bypasses RLS and must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No analytics beyond what you host yourself (PRD section 13). This is a record
# of what two people eat and it does not need to be anyone else's business.
NEXT_TELEMETRY_DISABLED=1

# Comma-separated emails seeded into the signup_allowlist table on first
# migration. After that, manage the allowlist in the database or via invite
# links — adding a member should not need a redeploy (decision D2).
BOOTSTRAP_SIGNUP_EMAILS=
